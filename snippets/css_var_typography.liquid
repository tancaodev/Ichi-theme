{%- doc -%}
  Outputs custom typography CSS variables, read from settings named by a prefix.
  Nothing is output unless `<prefix>_size` is 'custom'; presets use the global type classes instead.
  Reads `<prefix>_font_family` (heading|body|highlight), `<prefix>_font_size` (px), `<prefix>_line_height` (%),
  `<prefix>_letter_spacing` (%), `<prefix>_font_weight` and `<prefix>_text_transform`.
  Mobile size and line height come from `<prefix>_font_size_mobile` and `<prefix>_line_height_mobile`
  when `<prefix>_typography_custom_mobile` is on, otherwise they repeat desktop.

  Outputs: --<prefix>-font-family, -font-weight, -letter-spacing, -text-transform,
  -font-size, -line-height and the -mobile variants of the last two.

  @param {object} component_settings - Settings object holding the prefixed settings (block.settings or section.settings).
  @param {string} prefix - Setting id and CSS variable prefix, e.g. 'heading'.

  @example
  {% render 'css_var_typography', component_settings: block.settings, prefix: 'heading' %}
{%- enddoc -%}
{%- liquid
  assign st = component_settings
  assign size_key = prefix | append: '_size'
  assign family_key = prefix | append: '_font_family'
  assign weight_key = prefix | append: '_font_weight'
  assign letter_spacing_key = prefix | append: '_letter_spacing'
  assign transform_key = prefix | append: '_text_transform'
  assign mobile_toggle_key = prefix | append: '_typography_custom_mobile'
  assign breakpoints = 'desktop,mobile' | split: ','

  if st[size_key] == 'custom'
    assign family = st[family_key] | default: 'heading'
    assign letter_spacing = st[letter_spacing_key] | default: 0 | divided_by: 100.0 | append: 'em'
    echo '--' | append: prefix | append: '-font-family: var(--font-' | append: family | append: '-family);'
    echo '--' | append: prefix | append: '-font-weight: ' | append: st[weight_key] | append: ';'
    echo '--' | append: prefix | append: '-letter-spacing: ' | append: letter_spacing | append: ';'
    echo '--' | append: prefix | append: '-text-transform: ' | append: st[transform_key] | append: ';'

    for breakpoint in breakpoints
      assign setting_suffix = ''
      assign var_suffix = ''
      if breakpoint == 'mobile'
        assign var_suffix = '-mobile'
        if st[mobile_toggle_key]
          assign setting_suffix = '_mobile'
        endif
      endif

      assign font_size_key = prefix | append: '_font_size' | append: setting_suffix
      assign line_height_key = prefix | append: '_line_height' | append: setting_suffix

      assign font_size = 'inherit'
      if st[font_size_key] != blank
        assign font_size = st[font_size_key] | divided_by: 10.0 | append: 'rem'
      endif
      assign line_height = st[line_height_key] | default: 100 | divided_by: 100.0

      echo '--' | append: prefix | append: '-font-size' | append: var_suffix | append: ': ' | append: font_size | append: ';'
      echo '--' | append: prefix | append: '-line-height' | append: var_suffix | append: ': ' | append: line_height | append: ';'
    endfor
  endif
-%}
