{%- doc -%}
  Outputs width and text alignment CSS variables, read from settings named by a prefix.
  Desktop values come from `<prefix>_width`, `<prefix>_width_unit`, `<prefix>_width_percent`,
  `<prefix>_width_pixel` and `<prefix>_alignment`. Mobile values come from the same ids suffixed
  with `_mobile` when `<prefix>_layout_custom_mobile` is on, otherwise they repeat desktop.
  "Fit" has no alignment of its own and inherits it from the parent.
  Full widths ("fill" and pixel max-widths) subtract `--<prefix>-margin-left|right`, so the block's
  margin must sit on the same element as its width (the one carrying `shopify_attributes`).

  Outputs: --<prefix>-width, --<prefix>-max-width, --<prefix>-alignment and their -mobile variants.

  @param {object} component_settings - Settings object holding the prefixed settings (block.settings or section.settings).
  @param {string} prefix - Setting id and CSS variable prefix, e.g. 'heading'.

  @example
  {% render 'css_var_layout', component_settings: block.settings, prefix: 'heading' %}
{%- enddoc -%}
{%- liquid
  assign st = component_settings
  assign mobile_toggle_key = prefix | append: '_layout_custom_mobile'
  assign breakpoints = 'desktop,mobile' | split: ','

  for breakpoint in breakpoints
    assign setting_suffix = ''
    assign var_suffix = ''
    if breakpoint == 'mobile'
      assign var_suffix = '-mobile'
      if st[mobile_toggle_key]
        assign setting_suffix = '_mobile'
      endif
    endif

    assign width_key = prefix | append: '_width' | append: setting_suffix
    assign unit_key = prefix | append: '_width_unit' | append: setting_suffix
    assign percent_key = prefix | append: '_width_percent' | append: setting_suffix
    assign pixel_key = prefix | append: '_width_pixel' | append: setting_suffix
    assign alignment_key = prefix | append: '_alignment' | append: setting_suffix

    assign margin_left_var = '--' | append: prefix | append: '-margin-left' | append: var_suffix
    assign margin_right_var = '--' | append: prefix | append: '-margin-right' | append: var_suffix
    assign width = 'calc(100% - var(' | append: margin_left_var | append: ', 0px) - var(' | append: margin_right_var | append: ', 0px))'
    assign max_width = 'none'
    assign alignment = st[alignment_key] | default: 'left'

    case st[width_key]
      when 'fit'
        assign width = 'fit-content'
        assign alignment = 'inherit'
      when 'custom'
        if st[unit_key] == 'pixel'
          assign max_width = st[pixel_key] | divided_by: 16.0 | append: 'rem'
        else
          assign width = st[percent_key] | append: '%'
        endif
    endcase

    echo '--' | append: prefix | append: '-width' | append: var_suffix | append: ': ' | append: width | append: ';'
    echo '--' | append: prefix | append: '-max-width' | append: var_suffix | append: ': ' | append: max_width | append: ';'
    echo '--' | append: prefix | append: '-alignment' | append: var_suffix | append: ': ' | append: alignment | append: ';'
  endfor
-%}
