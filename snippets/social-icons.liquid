{% comment %}
  Renders the social account links from the Social media theme settings.
  Type, style, box style, shape and size come from the theme settings (see social_variables).

  Usage:
  {% render 'social-icons' %}
{% endcomment %}
{%- liquid
  assign platforms = 'facebook,instagram,tiktok,twitter,snapchat,pinterest,tumblr,youtube,vimeo' | split: ','
  assign list_class = 'list-social--' | append: settings.social_type | append: ' list-social--' | append: settings.social_style
  if settings.social_style == 'boxed'
    assign list_class = list_class | append: ' list-social--' | append: settings.social_box_style
  endif
-%}
<ul class="footer__list-social list-unstyled list-social {{ list_class }}">
  {%- for platform in platforms -%}
    {%- assign link_key = 'social_' | append: platform | append: '_link' -%}
    {%- assign link = settings[link_key] -%}
    {%- if link != blank -%}
      {%- assign label_key = 'general.social.links.' | append: platform -%}
      <li class="list-social__item">
        <a href="{{ link }}" class="link list-social__link">
          {%- if settings.social_type == 'text' -%}
            {{ label_key | t }}
          {%- else -%}
            {%- assign icon = platform -%}
            {%- if platform == 'twitter' -%}{%- assign icon = 'x' -%}{%- endif -%}
            {%- render 'snip_icon', icon: icon -%}
            <span class="visually-hidden">{{ label_key | t }}</span>
          {%- endif -%}
        </a>
      </li>
    {%- endif -%}
  {%- endfor -%}
</ul>
