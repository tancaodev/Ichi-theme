{%- doc -%}
  Outputs the CSS custom properties driven by the Layout and Section theme settings.
  Render inside a `{% style %}` tag. Mobile values are the base; desktop values apply from 992px.

  Radius scale (Figma DS "General"): `settings.main_corner` picks a scale of four steps,
  main / small / extra small / 2x small, with its own mobile values:
    30 → 30, 20, 10, 5 (mobile 15, 10, 5, 5)
    20 → 20, 10, 5, 0  (mobile 10, 5, 5, 0)
    10 → 10, 5, 2.5, 0 (mobile 10, 5, 2.5, 0)
    0  → 0
  The scale is exposed as `--radius-main/-small/-x-small/-2x-small` for every element.
  Sections use the step chosen in `settings.section_radius` (or a custom value) only in the
  Bento layout; Classic sections are square.

  @example
  {% style %}
    {% render 'section_variables' %}
  {% endstyle %}
{%- enddoc -%}

{%- liquid
  case settings.main_corner
    when '30'
      assign scale_desktop = '30,20,10,5'
      assign scale_mobile = '15,10,5,5'
    when '20'
      assign scale_desktop = '20,10,5,0'
      assign scale_mobile = '10,5,5,0'
    when '10'
      assign scale_desktop = '10,5,2.5,0'
      assign scale_mobile = '10,5,2.5,0'
    else
      assign scale_desktop = '0,0,0,0'
      assign scale_mobile = '0,0,0,0'
  endcase
  assign scale_desktop = scale_desktop | split: ','
  assign scale_mobile = scale_mobile | split: ','
  assign scale_levels = 'radius-main,radius-small,radius-x-small,radius-2x-small' | split: ','

  case settings.section_radius
    when 'main'
      assign section_radius_desktop = scale_desktop[0]
      assign section_radius_mobile = scale_mobile[0]
    when 'small'
      assign section_radius_desktop = scale_desktop[1]
      assign section_radius_mobile = scale_mobile[1]
    when 'extra_small'
      assign section_radius_desktop = scale_desktop[2]
      assign section_radius_mobile = scale_mobile[2]
    when 'custom'
      assign section_radius_desktop = settings.section_radius_custom
      assign section_radius_mobile = settings.section_radius_custom | divided_by: 2.0
    else
      assign section_radius_desktop = 0
      assign section_radius_mobile = 0
  endcase

  if settings.section_layout != 'bento'
    assign section_radius_desktop = 0
    assign section_radius_mobile = 0
  endif

  assign sides = 'top,right,bottom,left' | split: ','
-%}

:root {
  {%- for level in scale_levels %}
  --{{ level }}: {{ scale_mobile[forloop.index0] | divided_by: 16.0 }}rem;
  {%- endfor %}

  --section-spacing: {{ settings.section_spacing | divided_by: 16.0 }}rem;
  --section-gutter: {{ settings.section_gutter | divided_by: 16.0 }}rem;
  --section-radius: {{ section_radius_mobile | divided_by: 16.0 }}rem;

  {%- for side in sides %}
    {%- assign key = 'section_padding_' | append: side | append: '_mobile' %}
  --section-padding-{{ side }}: {{ settings[key] | divided_by: 16.0 }}rem;
  {%- endfor %}
}

@media screen and (min-width: 992px) {
  :root {
    {%- for level in scale_levels %}
    --{{ level }}: {{ scale_desktop[forloop.index0] | divided_by: 16.0 }}rem;
    {%- endfor %}

    --section-radius: {{ section_radius_desktop | divided_by: 16.0 }}rem;

    {%- for side in sides %}
      {%- assign key = 'section_padding_' | append: side %}
    --section-padding-{{ side }}: {{ settings[key] | divided_by: 16.0 }}rem;
    {%- endfor %}
  }
}
