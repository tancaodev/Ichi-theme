{% comment %}
  Typography variables
  Outputs the @font-face rules and CSS custom properties driven by the Typography theme settings.
  Mobile font sizes are the base; desktop font sizes are applied from 992px.

  Usage:
  {% style %}
    {% render 'typography_variables' %}
  {% endstyle %}
{% endcomment %}

{%- liquid
  assign heading_font = settings.type_header_font
  assign highlight_font = settings.type_highlight_font
  assign body_font = settings.type_body_font

  assign heading_styles = 'display,h1,h2,h3,h4,h5,h6'
  assign body_styles = 'paragraph,description,label'
  if settings.subheading_font == 'heading'
    assign heading_styles = heading_styles | append: ',subheading'
  else
    assign body_styles = body_styles | append: ',subheading'
  endif
  assign heading_styles = heading_styles | split: ','
  assign body_styles = body_styles | split: ','

  assign heading_weight_values = ''
  for style in heading_styles
    assign key = style | append: '_font_weight'
    assign heading_weight_values = heading_weight_values | append: settings[key] | append: ','
  endfor
  assign heading_weight_values = heading_weight_values | split: ',' | uniq

  assign body_weight_values = ''
  for style in body_styles
    assign key = style | append: '_font_weight'
    assign body_weight_values = body_weight_values | append: settings[key] | append: ','
  endfor
  assign body_weight_values = body_weight_values | split: ',' | uniq

  assign body_font_bold = body_font | font_modify: 'weight', 'bold'
  assign body_font_italic = body_font | font_modify: 'style', 'italic'
  assign body_font_bold_italic = body_font_bold | font_modify: 'style', 'italic'

  assign highlight_font_variant = highlight_font | font_modify: 'weight', settings.highlight_font_weight
  if settings.highlight_font_style == 'italic'
    assign highlight_font_variant = highlight_font_variant | default: highlight_font | font_modify: 'style', 'italic'
  endif

  assign styles = 'display,h1,h2,h3,h4,h5,h6,subheading,paragraph,description,label' | split: ','
-%}

{{ body_font | font_face: font_display: 'swap' }}
{{ body_font_bold | font_face: font_display: 'swap' }}
{{ body_font_italic | font_face: font_display: 'swap' }}
{{ body_font_bold_italic | font_face: font_display: 'swap' }}
{%- for weight in body_weight_values %}
  {{ body_font | font_modify: 'weight', weight | font_face: font_display: 'swap' }}
{%- endfor %}
{{ heading_font | font_face: font_display: 'swap' }}
{%- for weight in heading_weight_values %}
  {{ heading_font | font_modify: 'weight', weight | font_face: font_display: 'swap' }}
{%- endfor %}
{{ highlight_font_variant | default: highlight_font | font_face: font_display: 'swap' }}

:root {
  --font-body--family: {{ body_font.family }}, {{ body_font.fallback_families }};
  --font-body--style: {{ body_font.style }};
  --font-body--weight: {{ settings.paragraph_font_weight }};
  --font-body--weight-bold: {{ settings.paragraph_font_weight | plus: 300 | at_most: 1000 }};

  --font-heading--family: {{ heading_font.family }}, {{ heading_font.fallback_families }};
  --font-heading--style: {{ heading_font.style }};
  --font-heading--weight: {{ settings.h1_font_weight }};

  --font-highlight--family: {{ highlight_font.family }}, {{ highlight_font.fallback_families }};
  --highlight-font-style: {{ settings.highlight_font_style }};
  --highlight-font-weight: {{ settings.highlight_font_weight }};
  --highlight-letter-spacing: {{ settings.highlight_letter_spacing | divided_by: 100.0 }}em;
  --highlight-text-transform: {{ settings.highlight_text_transform }};

  --subheading-font-family: var(--font-{{ settings.subheading_font }}--family);
  --paragraph-spacing: {{ settings.paragraph_spacing | divided_by: 16.0 }}rem;
  {%- for style in styles %}
    {%- liquid
      # Description has no settings of its own: it follows Paragraph, 2px smaller (DS: 16 → 14, 14 → 12).
      assign source = style
      assign size_offset = 0
      if style == 'description'
        assign source = 'paragraph'
        assign size_offset = 2
      endif
      assign size_key = source | append: '_font_size_mobile'
      assign line_height_key = source | append: '_line_height'
      assign letter_spacing_key = source | append: '_letter_spacing'
      assign weight_key = source | append: '_font_weight'
      assign transform_key = source | append: '_text_transform'
    %}
  --{{ style }}-font-size: {{ settings[size_key] | times: 1 | minus: size_offset | divided_by: 16.0 }}rem;
    {%- if settings[line_height_key] %}
  --{{ style }}-line-height: {{ settings[line_height_key] | divided_by: 100.0 }};
    {%- endif %}
  --{{ style }}-letter-spacing: {{ settings[letter_spacing_key] | divided_by: 100.0 }}em;
  --{{ style }}-font-weight: {{ settings[weight_key] }};
    {%- if settings[transform_key] %}
  --{{ style }}-text-transform: {{ settings[transform_key] }};
    {%- endif %}
  {%- endfor %}
}

@media screen and (min-width: 992px) {
  :root {
    {%- for style in styles %}
      {%- liquid
        assign source = style
        assign size_offset = 0
        if style == 'description'
          assign source = 'paragraph'
          assign size_offset = 2
        endif
        assign size_key = source | append: '_font_size'
      -%}
    --{{ style }}-font-size: {{ settings[size_key] | times: 1 | minus: size_offset | divided_by: 16.0 }}rem;
    {%- endfor %}
  }
}
