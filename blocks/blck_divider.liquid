{% render 'snip_divider', component_settings: block.settings, component_id: block.id, attributes: block.shopify_attributes %}

{% schema %}
{
  "name": "t:blocks.divider.name",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "divider_direction",
      "label": "t:blocks.divider.settings.direction.label",
      "options": [
        {
          "value": "horizontal",
          "label": "t:blocks.divider.settings.direction.options__horizontal"
        },
        {
          "value": "vertical",
          "label": "t:blocks.divider.settings.direction.options__vertical"
        }
      ],
      "default": "horizontal"
    },
    {
      "type": "range",
      "id": "divider_width",
      "label": "t:blocks.divider.settings.width.label",
      "min": 5,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.divider_direction == 'horizontal' }}"
    },
    {
      "type": "range",
      "id": "divider_height",
      "label": "t:blocks.divider.settings.height.label",
      "min": 5,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.divider_direction == 'vertical' }}"
    },
    {
      "type": "range",
      "id": "divider_thickness",
      "label": "t:blocks.divider.settings.thickness.label",
      "min": 1,
      "max": 6,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "checkbox",
      "id": "divider_layout_custom_mobile",
      "label": "t:blocks.shared.settings.custom_mobile.label",
      "default": false
    },
    {
      "type": "select",
      "id": "divider_direction_mobile",
      "label": "t:blocks.divider.settings.direction.label",
      "options": [
        {
          "value": "horizontal",
          "label": "t:blocks.divider.settings.direction.options__horizontal"
        },
        {
          "value": "vertical",
          "label": "t:blocks.divider.settings.direction.options__vertical"
        }
      ],
      "default": "horizontal",
      "visible_if": "{{ block.settings.divider_layout_custom_mobile }}"
    },
    {
      "type": "range",
      "id": "divider_width_mobile",
      "label": "t:blocks.divider.settings.width.label",
      "min": 5,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.divider_layout_custom_mobile and block.settings.divider_direction_mobile == 'horizontal' }}"
    },
    {
      "type": "range",
      "id": "divider_height_mobile",
      "label": "t:blocks.divider.settings.height.label",
      "min": 5,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.divider_layout_custom_mobile and block.settings.divider_direction_mobile == 'vertical' }}"
    },
    {
      "type": "range",
      "id": "divider_thickness_mobile",
      "label": "t:blocks.divider.settings.thickness.label",
      "min": 1,
      "max": 6,
      "step": 1,
      "unit": "px",
      "default": 1,
      "visible_if": "{{ block.settings.divider_layout_custom_mobile }}"
    },
    {
      "type": "header",
      "content": "t:blocks.divider.settings.header_style.content"
    },
    {
      "type": "select",
      "id": "divider_style",
      "label": "t:blocks.divider.settings.style.label",
      "options": [
        {
          "value": "line",
          "label": "t:blocks.divider.settings.style.options__line"
        },
        {
          "value": "dot",
          "label": "t:blocks.divider.settings.style.options__dot"
        }
      ],
      "default": "line"
    },
    {
      "type": "select",
      "id": "divider_corner_radius",
      "label": "t:blocks.divider.settings.corner_radius.label",
      "options": [
        {
          "value": "square",
          "label": "t:blocks.divider.settings.corner_radius.options__square"
        },
        {
          "value": "rounded",
          "label": "t:blocks.divider.settings.corner_radius.options__rounded"
        }
      ],
      "default": "rounded"
    },
    {
      "type": "header",
      "content": "t:blocks.shared.settings.header_spacing.content"
    },
    {
      "type": "range",
      "id": "divider_margin_top",
      "label": "t:blocks.shared.settings.margin_top.label",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "divider_margin_bottom",
      "label": "t:blocks.shared.settings.margin_bottom.label",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "divider_margin_left",
      "label": "t:blocks.shared.settings.margin_left.label",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "divider_margin_right",
      "label": "t:blocks.shared.settings.margin_right.label",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "divider_margin_custom_mobile",
      "label": "t:blocks.shared.settings.custom_mobile.label",
      "default": false
    },
    {
      "type": "range",
      "id": "divider_margin_top_mobile",
      "label": "t:blocks.shared.settings.margin_top.label",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.divider_margin_custom_mobile }}"
    },
    {
      "type": "range",
      "id": "divider_margin_bottom_mobile",
      "label": "t:blocks.shared.settings.margin_bottom.label",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.divider_margin_custom_mobile }}"
    },
    {
      "type": "range",
      "id": "divider_margin_left_mobile",
      "label": "t:blocks.shared.settings.margin_left.label",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.divider_margin_custom_mobile }}"
    },
    {
      "type": "range",
      "id": "divider_margin_right_mobile",
      "label": "t:blocks.shared.settings.margin_right.label",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.divider_margin_custom_mobile }}"
    }
  ],
  "presets": [
    {
      "name": "t:blocks.divider.name"
    }
  ]
}
{% endschema %}
